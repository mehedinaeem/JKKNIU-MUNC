# Copy to .env; supply your own local key. Never commit .env.
DEBUG=True
SECRET_KEY=replace-with-your-local-development-key
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
USE_SQLITE=True
DATABASE_URL=
# Local PostgreSQL can use False; production defaults to required TLS.
DATABASE_SSL_REQUIRE=False
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# New submission storage: development uses private OS temporary files.
SUBMISSION_STORAGE_PROVIDER=temporary
# Optional LOCAL_PRIVATE_UPLOAD_ROOT: choose a development temporary directory.
# Production: use cloudinary and supply real server-side provider values securely.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Alternative CLOUDINARY_URL takes precedence; leave blank for local temporary storage.
CLOUDINARY_URL=
# Production requires a shared Redis cache. Local development uses memory caching.
REDIS_URL=
SUBMISSION_RATE_PER_MINUTE=5
SUBMISSION_RATE_PER_HOUR=30
SUBMISSION_EMAIL_RATE_PER_HOUR=5
# Use 1 only behind the intended trusted Heroku router; local direct requests use 0.
TRUSTED_PROXY_COUNT=0
# PRIVATE_UPLOAD_STORAGE_BACKEND / OPTIONS are legacy-read configuration only.

# Administrator sessions: proxy mode is recommended. Local split-origin requests
# use explicit credentialed CORS defaults with localhost on both ports.
AUTH_COOKIE_MODE=proxy
ADMIN_SESSION_MAX_AGE=28800
LOGIN_RATE_PER_MINUTE=10
LOGIN_RATE_PER_HOUR=100
LOGIN_USERNAME_RATE_PER_15_MINUTES=10
# Production proxy mode needs no credentialed CORS. For unavoidable HTTPS
# cross-site cookies, see AUTHENTICATION.md and explicitly set trusted origins.
# CORS_ALLOW_CREDENTIALS=True
